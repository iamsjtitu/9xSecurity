{
  "name": "ninex-security",
  "productName": "9x Security",
  "version": "1.0.0",
  "description": "Gate vehicle monitoring with AI (Entry/Exit detection + WhatsApp alerts)",
  "main": "electron-main.js",
  "author": "9x Security",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "dist": "vite build && electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.ninex.security",
    "productName": "9x Security",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron-main.js",
      "preload.js",
      "assets/**"
    ],
    "extraResources": [
      {
        "from": "../dist/9xEngine",
        "to": "engine"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png",
      "artifactName": "9xSecuritySetup-v${version}.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true
    }
  }
}
